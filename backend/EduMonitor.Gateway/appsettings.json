{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "EduMonitorAI_Secret_Key_FISEI_UTA_2026_SecureKey_MustBeLong!",
    "Issuer": "EduMonitorApi",
    "Audience": "EduMonitorClient"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "backend-api-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "moodle-route": {
        "ClusterId": "backend-api-cluster",
        "Match": {
          "Path": "/api/moodle/{**catch-all}"
        }
      },
      "academico-route": {
        "ClusterId": "backend-api-cluster",
        "Match": {
          "Path": "/api/academico/{**catch-all}"
        }
      },
      "ai-agent-route": {
        "ClusterId": "ai-service-cluster",
        "Match": {
          "Path": "/api/agent/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "backend-api-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "ai-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:8000"
          }
        }
      }
    }
  }
}
