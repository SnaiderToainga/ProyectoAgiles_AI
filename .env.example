# Copie este archivo como .env (no se versiona) antes de ejecutar: docker compose up -d --build
# Contrasena de SQL Server (minimo 8 caracteres con mayuscula, minuscula, numero y simbolo)
MSSQL_SA_PASSWORD=EduMonitor_Dev_2026!
# Clave JWT compartida por Gateway y API (minimo 32 caracteres)
JWT_KEY=EduMonitorAI_Secret_Key_FISEI_UTA_2026_SecureKey_MustBeLong!
# Dejar vacia para usar el motor de contingencia local del asistente de IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Token de Moodle (Moodle se ejecuta aparte en docker/moodle, puerto 8080)
MOODLE_BASE_URL=http://host.docker.internal:8080
MOODLE_TOKEN=
