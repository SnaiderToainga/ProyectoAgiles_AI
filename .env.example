# Copie este archivo como .env (no se versiona) antes de ejecutar: docker compose up -d --build
# Complete los valores vacios; ninguno debe subirse al repositorio.

# Contrasena de SQL Server (minimo 8 caracteres con mayuscula, minuscula, numero y simbolo)
MSSQL_SA_PASSWORD=

# Clave JWT compartida por Gateway y API: propia, de al menos 32 caracteres.
# Generela en PowerShell con:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_KEY=

# Contrasena de las cuentas de ejemplo d.proano@uta.edu.ec y s.toainga@uta.edu.ec en este entorno de
# demostracion. Si se deja vacia, no se restablecen y no podra iniciar sesion con ellas en una base nueva.
DEMO_PASSWORD=

# Dejar vacia para usar el motor de contingencia local del asistente de IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Moodle se ejecuta aparte en docker/moodle (puerto 8080). El token es el de la cuenta de servicio:
# copie "moodleToken" de docker/moodle/.local/moodle-connection.json
MOODLE_BASE_URL=http://host.docker.internal:8080
MOODLE_TOKEN=
